# Entorno de aplicación Maestro
APP_ENV=development
LOG_LEVEL=INFO

# Seguridad del Webhook y Reportes
WEBHOOK_SECRET_TOKEN=cambia_este_token_secreto_local
REPORT_API_TOKEN=cambia_este_token_de_reporte

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=maestro_dev_evolution_key_2026
EVOLUTION_DEFAULT_INSTANCE=magic-tour
TENANT_DEFAULT_ID=magic-tour

# Google Gemini (Fase 2+)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REASONING_EFFORT=low
DEBOUNCE_SECONDS=4.0

# Base de datos SQLite (Fase 3+)
DB_PATH=maestro.db
